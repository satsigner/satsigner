{
  "name": "@satsigner/mobile",
  "version": "0.3.6",
  "private": true,
  "description": "Privacy-first Bitcoin signer with complete UTXO control",
  "main": "./index.js",
  "react-native": {
    "net": "react-native-tcp-socket",
    "tls": "react-native-tcp-socket",
    "fs": "react-native-tcp-socket"
  },
  "scripts": {
    "android": "expo run:android",
    "android:dev": "cross-env APP_VARIANT=development expo run:android",
    "android:prod": "cross-env APP_VARIANT=production expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "cross-env APP_VARIANT=development expo run:ios",
    "ios:prod": "cross-env APP_VARIANT=production expo run:ios",
    "prebuild:dev": "cross-env APP_VARIANT=development expo prebuild --clean",
    "prebuild:prod": "cross-env APP_VARIANT=production expo prebuild --clean",
    "sb:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:android",
    "sb:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "start": "expo start",
    "variant": "node --experimental-strip-types scripts/variant.ts",
    "storybook-generate": "sb-rn-get-stories",
    "test": "pnpm test:unit && pnpm test:int",
    "test:int": "jest ./tests/int",
    "test:int:nostr": "node scripts/nostr-roundtrip.mjs",
    "diagnose:nostr": "node scripts/nostr-diagnose.mjs",
    "test:int:payjoin": "jest ./tests/int/api/payjoin-signet.test.ts",
    "test:unit": "jest ./tests/unit",
    "maestro:prep": "bash .maestro/scripts/prep-android.sh",
    "maestro:link-studio": "bash .maestro/scripts/link-studio-workspace.sh",
    "maestro:last": "bash .maestro/scripts/last-failure.sh",
    "maestro:sync": "bash .maestro/scripts/sync-studio-results.sh",
    "maestro": "bash .maestro/scripts/run-with-results.sh .maestro",
    "maestro:smoke": "bash .maestro/scripts/run-with-results.sh .maestro/flows/smoke-boot.yaml",
    "maestro:all": "bash .maestro/scripts/run-all.sh",
    "maestro:payjoin:receive": "bash .maestro/scripts/run-with-results.sh .maestro/flows/payjoin-receive-signet.yaml",
    "maestro:payjoin:receive:fresh": "bash .maestro/scripts/run-with-results.sh .maestro/flows/payjoin-receive-fresh-signet.yaml",
    "maestro:payjoin:receive:clown": "bash .maestro/scripts/run-with-results.sh .maestro/flows/payjoin-receive-clown-signet.yaml",
    "maestro:payjoin:receive:new": "bash .maestro/scripts/run-with-results.sh .maestro/flows/payjoin-receive-new-wallet-signet.yaml",
    "maestro:payjoin:receive:empty": "bash .maestro/scripts/run-with-results.sh .maestro/flows/payjoin-receive-empty-wallet-signet.yaml",
    "maestro:payjoin:send": "bash .maestro/scripts/run-payjoin-send.sh",
    "maestro:payjoin:sample-to-clown": "bash .maestro/scripts/payjoin-sample-to-clown.sh",
    "maestro:payjoin:sample-to-new": "bash .maestro/scripts/payjoin-sample-to-clown.sh",
    "maestro:payjoin:roundtrip": "bash .maestro/scripts/payjoin-roundtrip.sh",
    "test:entropy": "jest ./tests/entropy-audit",
    "entropy:audit": "cross-env ENTROPY_AUDIT_SAMPLES=5000 jest ./tests/entropy-audit --verbose",
    "typecheck": "tsc --noEmit",
    "types": "expo customize tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@cashu/cashu-ts": "^3.0.0",
    "@gandlaf21/bolt11-decode": "^3.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@ngraveio/bc-ur": "^1.1.13",
    "@noble/hashes": "1.8.0",
    "@nostr-dev-kit/ndk": "^2.14.5",
    "@react-native-community/netinfo": "12.0.1",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "2.4.0",
    "@secondts/bark-react-native": "^0.26.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.64.2",
    "assert": "^1.1.1",
    "bech32": "^2.0.0",
    "bip-321": "0.0.11",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bitcoin-decoder": "^0.9.0",
    "bitcoinjs-lib": "^6.1.7",
    "bs58check": "^3.0.1",
    "buffer": "6.0.3",
    "cbor-js": "^0.1.0",
