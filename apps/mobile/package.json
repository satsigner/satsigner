    "electrum-client": "https://github.com/BlueWallet/rn-electrum-client#1bfe3cc4249d5440b816baac942b0cfa921eebf9",
    "events": "^1.0.0",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-modules-core": "~58.0.26",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18n-js": "^4.4.3",
    "immer": "^11.1.4",
    "nostr-tools": "^2.23.3",
    "pako": "^2.1.0",
    "process": "^0.11.0",
    "promise": "^8.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bdk-sdk": "0.8.0",
    "react-native-bouncy-checkbox": "^4.1.4",
    "react-native-device-info": "^15.0.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nfc-manager": "^4.0.0-beta.7",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-nitro-sqlite": "^9.6.0",
    "react-native-pager-view": "9.0.7",
    "react-native-payjoin": "^0.7.0",
    "react-native-qrcode-svg": "^6.3.1",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-uuid": "^2.0.4",
    "react-native-view-shot": "~6.1.1",
    "react-native-worklets": "0.13.0",
    "react-timeago": "^7.2.0",
    "sonner-native": "^0.25.1",
    "varuint-bitcoin": "1.1.2",
    "victory-native": "^42.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/metro-config": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native/jest-preset": "0.88.0",
    "@storybook/addon-ondevice-actions": "^10.4.4",
    "@storybook/addon-ondevice-backgrounds": "^10.4.4",
    "@storybook/addon-ondevice-controls": "^10.4.4",
    "@storybook/addon-ondevice-notes": "^10.4.4",
    "@storybook/react-native": "^10.4.4",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time-format": "^4.0.3",
    "@types/jest": "^30.0.0",
    "@types/pako": "^2.0.3",
    "@types/react": "~19.3.0",
    "@types/react-timeago": "^4.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "storybook": "^10.4.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-bouncy-checkbox",
          "react-native-nfc-manager",
          "react-native-tcp-socket"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
